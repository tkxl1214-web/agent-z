rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedInAs(userId) {
      return request.auth != null && request.auth.uid == userId;
    }

    match /users/{userId}/memories/{memoryId} {
      allow read: if signedInAs(userId);
      allow create, update: if signedInAs(userId)
        && request.resource.data.keys().hasOnly(['text', 'createdAt', 'updatedAt'])
        && request.resource.data.text is string
        && request.resource.data.text.size() > 0
        && request.resource.data.text.size() <= 400;
      allow delete: if signedInAs(userId);
    }

    match /users/{userId}/conversations/{conversationId} {
      allow read: if signedInAs(userId);
      allow create, update: if signedInAs(userId)
        && request.resource.data.keys().hasOnly(['id', 'title', 'updatedAt'])
        && request.resource.data.id == conversationId
        && request.resource.data.title is string
        && request.resource.data.title.size() <= 54
        && request.resource.data.updatedAt == request.time;
      allow delete: if signedInAs(userId);

      match /messages/{messageId} {
        allow read: if signedInAs(userId);
        allow create: if signedInAs(userId)
          && request.resource.data.keys().hasOnly(['role', 'content', 'createdAt'])
          && request.resource.data.role in ['user', 'assistant']
          && request.resource.data.content is string
          && request.resource.data.content.size() > 0
          && request.resource.data.content.size() <= 20000
          && request.resource.data.createdAt == request.time;
        allow update: if false;
        allow delete: if signedInAs(userId);
      }
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
